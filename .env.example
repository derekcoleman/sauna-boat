# ---- Site / brand (the bracketed placeholders from the brief) ----
NEXT_PUBLIC_BRAND_NAME="Sauna Boat"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"      # production: https://yourdomain.com
NEXT_PUBLIC_DEPOSIT_USD=250                        # refundable deposit
NEXT_PUBLIC_SESSION_PRICE_USD=900                  # private session, 2.5 h, up to 6 guests

# ---- Supabase (required) ----
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."                 # server only, never exposed to the browser

# ---- Stripe (required; test keys by default) ----
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."                  # from `stripe listen` locally, or the dashboard in prod

# ---- Email (optional; without it, emails are logged to the console) ----
RESEND_API_KEY=""
EMAIL_FROM="Sauna Boat <hello@yourdomain.com>"     # must be a verified Resend domain in production
ADMIN_EMAIL="you@yourdomain.com"                   # receives refund requests

# ---- Security ----
EMAIL_TOKEN_SECRET="change-me-to-a-long-random-string"   # signs magic-link tokens (16+ chars)
ADMIN_PASSWORD=""                                  # enables /admin (basic auth, any username)
CRON_SECRET=""                                     # protects /api/cron/nudge (Vercel sends it automatically)
